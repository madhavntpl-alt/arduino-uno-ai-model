  Serial.print(F("Context: ")); Serial.print(CONTEXT_WINDOW); Serial.println(F(" tokens"));
  Serial.print(F("Hidden: ")); Serial.print(HIDDEN_DIM); Serial.println(F(" units"));
  Serial.print(F("Params: ")); Serial.println(PARAMETER_COUNT);
  Serial.print(F("Flash (model): ")); Serial.print(estimate_flash_usage()); Serial.println(F(" bytes"));
