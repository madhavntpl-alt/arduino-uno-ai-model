}

static void cmd_memory() {
  Serial.println(F("MEMORY USAGE"));
  Serial.println(F("------------"));
  Serial.print(F("Free RAM: ")); Serial.print(freeRam()); Serial.println(F(" bytes"));
  Serial.print(F("Stack Free: ")); Serial.print(checkStack()); Serial.println(F(" bytes"));
  Serial.print(F("Input Buffer: ")); Serial.print(MAX_INPUT_CHARS); Serial.println(F(" bytes"));
  Serial.print(F("Context Buffer: ")); Serial.print(CONTEXT_WINDOW); Serial.println(F(" bytes"));
  Serial.print(F("Inference Scratch: ~")); 
  Serial.print(INPUT_DIM * 2 + HIDDEN_DIM * 4 + VOCAB_SIZE * 4 + 200); 
  Serial.println(F(" bytes"));
  Serial.println();
  Serial.print(F("Flash Used (est): ")); Serial.print(estimate_flash_usage()); Serial.println(F(" bytes"));
  Serial.print(F("Flash Free (est): ")); Serial.print(32768 - 2048 - estimate_flash_usage()); Serial.println(F(" bytes"));
}

static void cmd_reset() {
  total_tokens_generated = 0;
  rep_hist_len = 0;
  rep_hist_pos = 0;
  memset(token_context, 0, CONTEXT_WINDOW);
  Serial.println(F("Conversation reset."));
}

static void cmd_clear() {
  rep_hist_len = 0;
  rep_hist_pos = 0;
  for (uint8_t i = 0; i < CONTEXT_WINDOW; i++) {
    token_context[i] = TOKEN_BOS;
  }
  Serial.println(F("Context cleared."));
}

static void process_command(const char* cmd) {
  if (strcmp(cmd, "/help") == 0) {
    cmd_help();
  } else if (strcmp(cmd, "/stats") == 0) {
    cmd_stats();
  } else if (strcmp(cmd, "/model") == 0) {
    cmd_model();
  } else if (strcmp(cmd, "/memory") == 0) {
    cmd_memory();
  } else if (strcmp(cmd, "/reset") == 0) {
    cmd_reset();
  } else if (strcmp(cmd, "/clear") == 0) {
    cmd_clear();
  } else {
    Serial.print(F("Unknown command: "));
    Serial.println(cmd);
    Serial.println(F("Type /help for commands."));
  }
}

// Flash/SRAM estimation functions
static uint16_t estimate_flash_usage() {
  uint32_t flash = 0;
  flash += VOCAB_SIZE * EMBED_DIM;           // Embedding table
  flash += HIDDEN_DIM * INPUT_DIM;           // Hidden weights
  flash += HIDDEN_DIM * 4;                   // Hidden bias (int32)
  if (!TIE_WEIGHTS) {
    flash += VOCAB_SIZE * HIDDEN_DIM;        // Output weights
  }
  flash += VOCAB_SIZE * 4;                   // Output bias (int32)
  flash += 5 * 4;                            // Scales (float)
  flash += 100;                              // Code + metadata overhead
  return (uint16_t)(flash > 65535 ? 65535 : flash);
}

static uint16_t estimate_sram_usage() {
  uint16_t sram = 0;
  sram += MAX_INPUT_CHARS + 1;               // Input buffer
  sram += CONTEXT_WINDOW;                    // Token context
  sram += REPETITION_WINDOW;                 // Repetition history
  sram += CONTEXT_WINDOW * EMBED_DIM * 2;    // Embedding scratch (int16)
  sram += INPUT_DIM * 2;                     // Flattened input (int16)
  sram += HIDDEN_DIM * 4;                    // Hidden accum (int32)
  sram += HIDDEN_DIM;                        // Hidden activations (int8)
  sram += VOCAB_SIZE * 4;                    // Output logits (int32)
  sram += 200;                               // Temp arithmetic
  sram += 64;                                // Serial buffer
  sram += 300;                               // Stack reserve
  return sram;
}

// ============================================================
// INPUT PROCESSING
// ============================================================

static void normalize_input(char* buf) {
  // Trim whitespace
  char* start = buf;
  while (*start == ' ' || *start == '\t' || *start == '\r' || *start == '\n') start++;
  
  char* end = start + strlen(start) - 1;
  while (end > start && (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n')) {
    *end-- = '\0';
  }
  
  if (start != buf) {
    memmove(buf, start, strlen(start) + 1);
  }
  
  // Truncate if too long
  if (strlen(buf) > MAX_INPUT_CHARS) {
    buf[MAX_INPUT_CHARS] = '\0';
  }
}

// ============================================================
// SETUP & MAIN LOOP
// ============================================================

void setup() {
  // Initialize serial
  Serial.begin(SERIAL_BAUD);
  
  // Wait for serial (up to 3 seconds)
  uint32_t start = millis();
  while (!Serial && millis() - start < 3000) {
    ; // Wait
  }
  
  // Disable watchdog (in case previous run enabled it)
  wdt_disable();
  
  // Fill stack with pattern for stack checking
  // Note: This is approximate
  uint8_t* p = (uint8_t*)RAMEND;
  while (p > (uint8_t*)0x200) {  // Don't overwrite registers
    *p-- = 0x55;
  }
  
  // Startup banner
  Serial.println();
  Serial.println(F("========================================"));
  Serial.println(F("           UNO-MIND"));
  Serial.println(F("   OFFLINE LOCAL LANGUAGE MODEL"));
  Serial.println(F("========================================"));
  Serial.print(F("Model: ")); Serial.println(MODEL_NAME);
  Serial.print(F("Tokenizer: ")); Serial.println(TOKENIZER_VERSION);
  Serial.print(F("Quantization: ")); Serial.println(QUANTIZATION);
  Serial.println(F("Status: READY"));
  Serial.println();
  Serial.println(F("YOU > "));
}

void loop() {
  // Check for serial input
  if (Serial.available()) {
    // Read line
    int len = Serial.readBytesUntil('\n', input_buffer, MAX_INPUT_CHARS);
    input_buffer[len] = '\0';
    
    // Also consume \r if present
    if (len > 0 && input_buffer[len-1] == '\r') {
      input_buffer[len-1] = '\0';
    }
    
    // Normalize
    normalize_input(input_buffer);
    
    // Empty input
    if (strlen(input_buffer) == 0) {
      Serial.println(F("(empty input)"));
      Serial.print(F("YOU > "));
      return;
    }
    
    // Check for command
    if (input_buffer[0] == '/') {
      process_command(input_buffer);
      Serial.print(F("YOU > "));
      return;
    }
    
    // Tokenize user input
    uint8_t user_tokens[CONTEXT_WINDOW + 10];  // Extra space for long input
    uint8_t user_token_count = tokenize(input_buffer, user_tokens, CONTEXT_WINDOW + 10);
    
    // Truncate if too many tokens (keep last CONTEXT_WINDOW)
    uint8_t ctx_start = 0;
    if (user_token_count > CONTEXT_WINDOW) {
      ctx_start = user_token_count - CONTEXT_WINDOW;
      user_token_count = CONTEXT_WINDOW;
    }
    
    // Generate response
    generate_response(user_tokens + ctx_start, user_token_count);
    
    // Prompt for next input
    Serial.print(F("YOU > "));
  }
  
  // Periodic watchdog reset (if enabled)
  // wdt_reset();
}

// ============================================================
// ERROR HANDLING
// ============================================================

// Handle unexpected crashes (minimal)
extern "C" void __cxa_pure_virtual() {
  while (1) ; // Halt
}