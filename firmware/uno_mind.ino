/*
 * UNO-MIND — Offline Local Language Model for Arduino Uno
 * 
 * Single-file firmware implementation.
 * Model weights in model_data.h (generated by training pipeline).
 * 
 * Hardware: Arduino Uno (ATmega328P)
 * 16 MHz | 2 KB SRAM | 32 KB Flash
 * 
 * Architecture: Byte-level tokenizer + Fixed-context MLP (INT8 quantized)
 * Inference: Autoregressive next-token prediction, greedy decoding
 */

// ============================================================
// CONFIGURATION & INCLUDES
// ============================================================

#include <avr/pgmspace.h>
#include <avr/wdt.h>
#include <string.h>
#include <stdint.h>
#include <stdlib.h>

// Model data (generated by export_arduino.py)
#include "model_data.h"

// Compile-time constants (fallback if model_data.h not present)
#ifndef VOCAB_SIZE
  #define VOCAB_SIZE 256
  #define EMBED_DIM 16
  #define CONTEXT_WINDOW 8
  #define HIDDEN_DIM 32
  #define INPUT_DIM (CONTEXT_WINDOW * EMBED_DIM)
  #define TIE_WEIGHTS 0
  #define TOKEN_BOS 255
  #define TOKEN_EOS 254
  #warning "model_data.h not found - using default config"
#endif

// Hardware limits
#define SERIAL_BAUD 115200
#define MAX_INPUT_CHARS 128
#define MAX_OUTPUT_TOKENS 128
#define REPETITION_PENALTY 15  // Logit penalty for repeated tokens
#define REPETITION_WINDOW 8    // Track last N tokens for penalty

// SRAM Buffers (statically allocated)
static char input_buffer[MAX_INPUT_CHARS + 1];
static uint8_t token_context[CONTEXT_WINDOW];
static uint8_t repetition_history[REPETITION_WINDOW];
static uint8_t rep_hist_len = 0;
static uint8_t rep_hist_pos = 0;

// Inference buffers (INT16/INT32 for accumulation)
static int16_t embedding_scratch[CONTEXT_WINDOW * EMBED_DIM];
static int16_t flattened_input[INPUT_DIM];
static int32_t hidden_accum[HIDDEN_DIM];
static int8_t hidden_activations[HIDDEN_DIM];
static int32_t output_logits[VOCAB_SIZE];

// Runtime state
static bool model_loaded = false;
static uint16_t total_tokens_generated = 0;
static uint32_t inference_cycles = 0;

// ============================================================
// UTILITY FUNCTIONS
// ============================================================

// Clamped ReLU for INT8: max(0, min(127, x))
static inline int8_t relu_int8(int32_t x) {
  if (x <= 0) return 0;
  if (x >= 127) return 127;
  return (int8_t)x;
}

// Saturating add for INT32
static inline int32_t sat_add32(int32_t a, int32_t b) {
  int32_t res = a + b;
  // Overflow check not needed for our ranges, but kept for safety
  return res;
}

// Free RAM measurement
static int freeRam() {
  extern int __heap_start, *__brkval;
  int v;
  return (int)&v - (__brkval == 0 ? (int)&__heap_start : (int)__brkval);
}

// Stack usage estimation (fill pattern)
static uint16_t checkStack() {
  uint16_t count = 0;
  uint8_t *p = (uint8_t*)RAMEND;
  while (p > (uint8_t*)&count && *p == 0x55) {
    p--;
    count++;
  }
  return count;
}

// ============================================================
// TOKENIZER (Byte-level)
// ============================================================

// Tokenize input string into context buffer
// Returns number of tokens written (including BOS/EOS)
static uint8_t tokenize(const char* input, uint8_t* output, uint8_t max_tokens) {
  uint8_t len = 0;
  output[len++] = TOKEN_BOS;
  
  while (*input && len < max_tokens - 1) {
    // Byte-level: each UTF-8 byte becomes a token
    output[len++] = (uint8_t)(*input++);
  }
  
  output[len++] = TOKEN_EOS;
  return len;
}

// Decode single token to serial output
static void detokenize(uint8_t token) {
  if (token < 254) {  // Regular byte (not BOS/EOS)
    Serial.write(token);
  }
}

// ============================================================
// MODEL INFERENCE (INT8 Quantized)
// ============================================================

// Embedding lookup: token_id -> EMBED_DIM values (dequantized to INT16)
// Reads from PROGMEM, applies scale
static void embedding_lookup(uint8_t token_id, int16_t* out) {
  const int8_t* row = (const int8_t*)pgm_read_ptr(&EMBEDDING_TABLE[token_id]);
  // EMBEDDING_TABLE is 2D array in PROGMEM
  // Need to compute offset manually for PROGMEM
  const int8_t* base = (const int8_t*)EMBEDDING_TABLE;
  const int8_t* src = base + token_id * EMBED_DIM;
  
  float scale = pgm_read_float(&EMBEDDING_SCALE);
  for (uint8_t i = 0; i < EMBED_DIM; i++) {
    int8_t w = pgm_read_byte(src + i);
    out[i] = (int16_t)(w * scale);
  }
}

// Build flattened input vector from token context
// context: [CONTEXT_WINDOW] token IDs
// out: [INPUT_DIM] INT16 values
static void build_flattened_input(const uint8_t* context, int16_t* out) {
  for (uint8_t t = 0; t < CONTEXT_WINDOW; t++) {
    embedding_lookup(context[t], embedding_scratch + t * EMBED_DIM);
  }
  // Copy to flattened input (already in embedding_scratch)
  memcpy(out, embedding_scratch, INPUT_DIM * sizeof(int16_t));
}

// Hidden layer: INT16 input * INT8 weights -> INT32 accum -> ReLU -> INT8
// Input: [INPUT_DIM] INT16
// Output: [HIDDEN_DIM] INT8 activations (in hidden_activations)
static void hidden_layer(const int16_t* input) {
  const int8_t* weights = (const int8_t*)HIDDEN_WEIGHTS;
  float w_scale = pgm_read_float(&HIDDEN_WEIGHT_SCALE);
  float b_scale = pgm_read_float(&HIDDEN_BIAS_SCALE);
  
  for (uint8_t j = 0; j < HIDDEN_DIM; j++) {
    int32_t acc = 0;
    const int8_t* w_row = weights + j * INPUT_DIM;
    
    // Dot product: input (INT16) * weights (INT8) -> INT32
    for (uint8_t i = 0; i < INPUT_DIM; i++) {
      int16_t in_val = input[i];
      int8_t w_val = pgm_read_byte(w_row + i);
      acc += (int32_t)in_val * (int32_t)w_val;
    }
    
    // Apply weight scale
    acc = (int32_t)(acc * w_scale);
    
    // Add bias (INT32)
    int32_t bias = (int32_t)pgm_read_dword(&HIDDEN_BIAS[j]) * b_scale;
    acc += bias;
    
    // ReLU + clamp to INT8
    hidden_activations[j] = relu_int8(acc);
  }
}

// Output layer: INT8 hidden * INT8 weights -> INT32 logits
// Output: [VOCAB_SIZE] INT32 logits
static void output_layer() {
  float w_scale, b_scale;
  const int8_t* weights;
  
  if (TIE_WEIGHTS) {
    // Tied: output weights = embedding table transposed
    // We need: hidden (HIDDEN_DIM) * embedding^T (EMBED_DIM x VOCAB_SIZE)
    // But HIDDEN_DIM may != EMBED_DIM. For simplicity, assume equal or use projection.
    // This implementation assumes HIDDEN_DIM == EMBED_DIM for tied weights.
    weights = (const int8_t*)EMBEDDING_TABLE;  // [VOCAB_SIZE][EMBED_DIM]
    w_scale = pgm_read_float(&EMBEDDING_SCALE);
  } else {
    weights = (const int8_t*)OUTPUT_WEIGHTS;
    w_scale = pgm_read_float(&OUTPUT_WEIGHT_SCALE);
  }
  b_scale = pgm_read_float(&OUTPUT_BIAS_SCALE);
  
  for (uint16_t v = 0; v < VOCAB_SIZE; v++) {
    int32_t acc = 0;
    const int8_t* w_row;
    
    if (TIE_WEIGHTS) {
      // Embedding table is [VOCAB_SIZE][EMBED_DIM], we need row v
      w_row = weights + v * EMBED_DIM;
      // But hidden_activations is HIDDEN_DIM. 
      // For tied weights with HIDDEN_DIM != EMBED_DIM, this is incorrect.
      // Simplification: only iterate min(HIDDEN_DIM, EMBED_DIM)
      uint8_t dim = (HIDDEN_DIM < EMBED_DIM) ? HIDDEN_DIM : EMBED_DIM;
      for (uint8_t i = 0; i < dim; i++) {
        acc += (int32_t)hidden_activations[i] * (int32_t)pgm_read_byte(w_row + i);
      }
    } else {
      w_row = weights + v * HIDDEN_DIM;
      for (uint8_t i = 0; i < HIDDEN_DIM; i++) {
        acc += (int32_t)hidden_activations[i] * (int32_t)pgm_read_byte(w_row + i);
      }
    }
    
    // Apply weight scale
    acc = (int32_t)(acc * w_scale);
    
    // Add bias
    int32_t bias = (int32_t)pgm_read_dword(&OUTPUT_BIAS[v]) * b_scale;
    acc += bias;
    
    output_logits[v] = acc;
  }
}

// Full forward pass: context tokens -> logits
static void forward_pass(const uint8_t* context) {
  build_flattened_input(context, flattened_input);
  hidden_layer(flattened_input);
  output_layer();
}

// Argmax with repetition penalty
static uint8_t sample_next_token() {
  // Apply repetition penalty
  for (uint8_t i = 0; i < rep_hist_len; i++) {
    uint8_t token = repetition_history[(rep_hist_pos + i) % REPETITION_WINDOW];
    if (token < VOCAB_SIZE) {
      output_logits[token] -= REPETITION_PENALTY;
    }
  }
  
  // Argmax
  int32_t max_logit = -2147483647L;
  uint8_t best_token = 0;
  
  for (uint16_t v = 0; v < VOCAB_SIZE; v++) {
    if (output_logits[v] > max_logit) {
      max_logit = output_logits[v];
      best_token = v;
    }
  }
  
  return best_token;
}

// Update context window with new token (shift left, append)
static void update_context(uint8_t new_token) {
  // Shift context left
  for (uint8_t i = 1; i < CONTEXT_WINDOW; i++) {
    token_context[i - 1] = token_context[i];
  }
  token_context[CONTEXT_WINDOW - 1] = new_token;
  
  // Update repetition history
  repetition_history[rep_hist_pos] = new_token;
  rep_hist_pos = (rep_hist_pos + 1) % REPETITION_WINDOW;
  if (rep_hist_len < REPETITION_WINDOW) rep_hist_len++;
}

// ============================================================
// GENERATION LOOP
// ============================================================

static void generate_response(const uint8_t* initial_context, uint8_t ctx_len) {
  // Initialize context window (pad with BOS if needed)
  for (uint8_t i = 0; i < CONTEXT_WINDOW; i++) {
    if (i < CONTEXT_WINDOW - ctx_len) {
      token_context[i] = TOKEN_BOS;
    } else {
      token_context[i] = initial_context[i - (CONTEXT_WINDOW - ctx_len)];
    }
  }
  
  // Clear repetition history
  rep_hist_len = 0;
  rep_hist_pos = 0;
  
  Serial.print("AI > ");
  
  uint8_t tokens_generated = 0;
  bool finished = false;
  
  while (!finished && tokens_generated < MAX_OUTPUT_TOKENS) {
    // Forward pass
    forward_pass(token_context);
    
    // Sample next token
    uint8_t next_token = sample_next_token();
    
    // Check for EOS
    if (next_token == TOKEN_EOS) {
      finished = true;
      break;
    }
    
    // Output token
    detokenize(next_token);
    
    // Update state
    update_context(next_token);
    tokens_generated++;
    total_tokens_generated++;
    
    // Small delay to not flood serial
    delay(1);
  }
  
  Serial.println();
}

