  Serial.print(F("Version: ")); Serial.println(MODEL_VERSION);
  Serial.print(F("Tokenizer: ")); Serial.println(TOKENIZER_VERSION);
  Serial.print(F("Quantization: ")); Serial.println(QUANTIZATION);
  Serial.print(F("Vocab: ")); Serial.print(VOCAB_SIZE); Serial.println(F(" tokens"));
